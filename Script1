local function updateButtonState(btn, stroke, label, active)
    if active then
        btn.Text = label .. ": ON"
        btn.TextColor3 = Color3.fromRGB(85, 255, 127)
        stroke.Color = Color3.fromRGB(85, 255, 127)
    else
        btn.Text = label .. ": OFF"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        stroke.Color = Color3.fromRGB(80, 80, 100)
    end
end

-- 1. Mobile Thumbstick Fly Logic
local function stopFly()
    IsFlyActive = false
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
    if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
    if Humanoid then Humanoid.PlatformStand = false end
    updateButtonState(flyBtn, flyStroke, "Fly", false)
end

local function startFly(speed)
    stopFly()
    IsFlyActive = true
    speed = speed or 50

    if not RootPart or not Humanoid then return end

    FlyBodyVel = Instance.new("BodyVelocity")
    FlyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyVel.Velocity = Vector3.zero
    FlyBodyVel.Parent = RootPart

    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyGyro.CFrame = RootPart.CFrame
    FlyBodyGyro.Parent = RootPart

    Humanoid.PlatformStand = true

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not IsFlyActive or not RootPart or not RootPart.Parent then return end
        
        local cam = Workspace.CurrentCamera
        local moveDir = Humanoid.MoveDirection
        
        FlyBodyGyro.CFrame = cam.CFrame
        
        if moveDir.Magnitude > 0 then
            local relativeVector = cam.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z))
            FlyBodyVel.Velocity = relativeVector * speed
        else
            FlyBodyVel.Velocity = Vector3.zero
        end
    end)
    updateButtonState(flyBtn, flyStroke, "Fly", true)
end

flyBtn.MouseButton1Click:Connect(function()
    if IsFlyActive then stopFly() else startFly(50) end
end)

