local function customRespawn(plr)
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ogpos = hrp.CFrame
    local ogpos2 = Workspace.CurrentCamera.CFrame
    
    local success, canReject = pcall(function()
        return gethiddenproperty(Workspace, "RejectCharacterDeletions") ~= Enum.RejectCharacterDeletions.Disabled
    end)
    if not success then canReject = false end

    if canReject and replicatesignal then
        pcall(function()
            replicatesignal(plr.ConnectDiedSignalBackend)
            task.wait(game:GetService("Players").RespawnTime - 0.1)
            replicatesignal(plr.Kill)
        end)
    else
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
        char:ClearAllChildren()

        local newgen = Instance.new("Model")
        newgen.Parent = Workspace
        plr.Character = newgen
        task.wait()
        plr.Character = plr.Character
        newgen:Destroy()
    end

    task.spawn(function()
        local newChar = plr.CharacterAdded:Wait()
        local newHrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if newHrp then
            newHrp.CFrame = ogpos
        end
        Workspace.CurrentCamera.CFrame = ogpos2
    end)
end

