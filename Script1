local function findPlayer(nameQuery)
    if not nameQuery then return nil end
    nameQuery = nameQuery:lower()
    if nameQuery == "random" then
        local players = Players:GetPlayers()
        if #players > 1 then
            local chosen
            repeat chosen = players[math.random(1, #players)] until chosen ~= LocalPlayer
            return chosen
        end
        return nil
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #nameQuery) == nameQuery or plr.DisplayName:lower():sub(1, #nameQuery) == nameQuery then
            return plr
        end
    end
    return nil
end

local function setupChatListener()
    LocalPlayer.Chatted:Connect(function(msg)
        local args = {}
        for word in msg:gmatch("%S+") do table.insert(args, word) end
        if #args == 0 then return end
        local rawCmd = args[1]:lower()

        -- Custom scriptrun handler
        if rawCmd == ".scriptrun" or rawCmd == "scriptrun" then
            StarterGui:SetCore("SendNotification", {
                Title = "Script Executor",
                Text = "Executing Script1...",
                Duration = 3
            })
            pcall(function()
                loadstring(game:HttpGet("https://github.com/CoolCatUserRebornV2/Chatgpt/raw/refs/heads/main/Script1"))()
            end)

        elseif rawCmd == ".fly" then
            startFly(tonumber(args[2]) or 50)
        elseif rawCmd == ".unfly" then
            stopFly()

        elseif rawCmd == ".infjump" then
            setInfJump(true)
        elseif rawCmd == ".uninfjump" then
            setInfJump(false)

        elseif rawCmd == ".xray" then
            setXray(true)
        elseif rawCmd == ".unxray" then
            setXray(false)

        elseif rawCmd == ".freeze" then
            IsFrozen = true
            if RootPart then RootPart.Anchored = true end
        elseif rawCmd == ".unfreeze" then
            IsFrozen = false
            if RootPart then RootPart.Anchored = false end

        elseif rawCmd == ".speed" then
            if Humanoid then Humanoid.WalkSpeed = tonumber(args[2]) or 32 end
        elseif rawCmd == ".unspeed" then
            if Humanoid then Humanoid.WalkSpeed = OriginalWalkSpeed end

        elseif rawCmd == ".jumppower" or rawCmd == ".jp" then
            if Humanoid then
                Humanoid.UseJumpPower = true
                Humanoid.JumpPower = tonumber(args[2]) or 100
            end
        elseif rawCmd == ".unjumppower" or rawCmd == ".unjp" then
            if Humanoid then Humanoid.JumpPower = OriginalJumpPower end

        elseif rawCmd == ".respawn" or rawCmd == ".re" or rawCmd == ".rs" then
            customRespawn(LocalPlayer)

        elseif rawCmd == ".noclip" then
            if not NoclipConnection then
                NoclipConnection = RunService.Stepped:Connect(function()
                    if Character then
                        for _, part in ipairs(Character:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end
                end)
            end
        elseif rawCmd == ".unnoclip" then
            if NoclipConnection then NoclipConnection:Disconnect() NoclipConnection = nil end

        elseif rawCmd == ".tp" then
            local target = findPlayer(args[2])
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                RootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end)
end

