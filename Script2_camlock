--------------------------------------------------------------------------------
-- 3. DRAGGABLE BUTTON LOGIC
--------------------------------------------------------------------------------
local draggingButton = false
local dragInput, dragStart, startPos

local function updateButtonInput(input)
	local delta = input.Position - dragStart
	MainButton.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

MainButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingButton = true
		dragStart = input.Position
		startPos = MainButton.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				draggingButton = false
			end
		end)
	end
end)

MainButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

--------------------------------------------------------------------------------
-- 4. DRAGGABLE SLIDER LOGIC
--------------------------------------------------------------------------------
local draggingSlider = false

local function updateSlider(input)
	local barPos = SliderBar.AbsolutePosition.X
	local barSize = SliderBar.AbsoluteSize.X
	local mouseX = input.Position.X
	local relativeX = math.clamp((mouseX - barPos) / barSize, 0, 1)

	SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
	
	-- Map 0.0 - 1.0 ratio to 30px - 300px FOV Radius
	FOVRadius = math.floor(30 + (relativeX * 270))
	SliderLabel.Text = "FOV Radius: " .. tostring(FOVRadius)
	FOVFrame.Size = UDim2.new(0, FOVRadius * 2, 0, FOVRadius * 2)
end

local function startSliderDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSlider = true
		updateSlider(input)
	end
end

SliderBar.InputBegan:Connect(startSliderDrag)
SliderKnob.InputBegan:Connect(startSliderDrag)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSlider = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingButton and input == dragInput then
		updateButtonInput(input)
	elseif draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSlider(input)
	end
end)

--------------------------------------------------------------------------------
-- 5. PREDICTIVE LOCK-ON MECHANICS (R6 / R15 DETECTOR)
--------------------------------------------------------------------------------
local targetPart = nil
local lockConnection = nil

-- Helper to safely get the target torso part based on rig type
local function getTorsoPart(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil, false end

	local isR6 = (humanoid.RigType == Enum.HumanoidRigType.R6)
	local torso = isR6 and character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	
	-- Fallback check in case RigType isn't set properly
	if not torso then
		torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
		isR6 = (torso and torso.Name == "Torso") or false
	end

	return torso, isR6
end

-- Find closest player within FOV
local function getClosestPlayerInFOV()
	local closestPlayer = nil
	local shortestDistance = math.huge
	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local torso = getTorsoPart(char)

			if humanoid and humanoid.Health > 0 and torso then
				local screenPos, onScreen = Camera:WorldToViewportPoint(torso.Position)
				if onScreen then
					local distancePoint = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
					if distancePoint <= FOVRadius and distancePoint < shortestDistance then
						shortestDistance = distancePoint
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer
end

local function unlockTarget()
	targetPart = nil
	MainButton.Text = "LOCK-ON"
	UIStroke.Color = Color3.fromRGB(0, 170, 255)
	
	if lockConnection then
		lockConnection:Disconnect()
		lockConnection = nil
	end
end

local function lockOntoTarget(player)
	local char = player.Character
	if not char then return end

	local torso, isR6 = getTorsoPart(char)
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not torso or not humanoid then return end

	-- Send R6 Notification if target is R6
	if isR6 then
		pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = "Lock System",
				Text = "Switched to r6 mode",
				Duration = 3
			})
		end)
	end

	targetPart = torso
	MainButton.Text = "LOCKED: " .. string.upper(player.DisplayName)
	UIStroke.Color = Color3.fromRGB(255, 50, 50)

	-- Automatically unlock when target dies
	local deathConn
	deathConn = humanoid.Died:Connect(function()
		unlockTarget()
		if deathConn then deathConn:Disconnect() end
	end)

	-- Initial Snap
	local initialPredictedPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * PREDICTION_STRENGTH)
	Camera.CFrame = CFrame.new(Camera.CFrame.Position, initialPredictedPos)

	-- Predictive Lock Loop
	lockConnection = RunService.RenderStepped:Connect(function()
		if not targetPart or not targetPart.Parent or humanoid.Health <= 0 then
			unlockTarget()
			return
		end

		local velocity = targetPart.AssemblyLinearVelocity
		local predictedPosition = targetPart.Position + (velocity * PREDICTION_STRENGTH)

		local currentCF = Camera.CFrame
		local targetCF = CFrame.new(currentCF.Position, predictedPosition)
		Camera.CFrame = currentCF:Lerp(targetCF, SNAP_SPEED)
	end)
end

MainButton.MouseButton1Click:Connect(function()
	if targetPart then
		unlockTarget()
	else
		local targetPlayer = getClosestPlayerInFOV()
		if targetPlayer then
			lockOntoTarget(targetPlayer)
		else
			TweenService:Create(UIStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), {
				Color = Color3.fromRGB(255, 150, 0)
			}):Play()
		end
	end
end)
